<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="LightRaw 1.2.0"
             Language="1033"
             Version="1.2.0.0"
             Manufacturer="Moestret"
             UpgradeCode="A2D3C4B5-E6F7-4819-B0A1-C2D3E4F5A6B7">

        <Package InstallerVersion="500"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Platform="x64"
                 Description="LightRaw Professional RAW Photo Editor &amp; Catalog"
                 Comments="LightRaw 1.2.0 Installer" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of LightRaw is already installed." />
        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

        <Icon Id="AppIcon" SourceFile="..\..\assets\icon.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon" />
        <Property Id="ARPHELPLINK" Value="https://github.com/moesstudio/LightRaw" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="LightRaw">
                    <Directory Id="AssetsFolder" Name="assets" />
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="LightRaw" />
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>

        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="B1C2D3E4-F5A6-47B8-99C0-D1E2F3A4B5C6" Win64="yes">
                <File Id="LightRawEXE"
                      Source="..\..\target\release\lightraw.exe"
                      KeyPath="yes"
                      Checksum="yes">
                    <Shortcut Id="ApplicationStartMenuShortcut"
                              Directory="ApplicationProgramsFolder"
                              Name="LightRaw"
                              Description="Launch LightRaw Photo Editor"
                              WorkingDirectory="INSTALLFOLDER"
                              Icon="AppIcon"
                              Advertise="yes" />
                    <Shortcut Id="ApplicationDesktopShortcut"
                              Directory="DesktopFolder"
                              Name="LightRaw"
                              Description="Launch LightRaw Photo Editor"
                              WorkingDirectory="INSTALLFOLDER"
                              Icon="AppIcon"
                              Advertise="yes" />
                </File>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="AssetsFolder">
            <Component Id="AssetsComponent" Guid="C2D3E4F5-A6B7-48C9-80D1-E2F3A4B5C6D7" Win64="yes">
                <File Id="IconIco" Source="..\..\assets\icon.ico" KeyPath="yes" />
                <File Id="IconPng" Source="..\..\assets\icon.png" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="D3E4F5A6-B7C8-49D0-91E2-F3A4B5C6D7E8">
                <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\Moestret\LightRaw" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <Feature Id="ProductFeature" Title="LightRaw 1.2.0" Level="1">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="AssetsComponent" />
            <ComponentRef Id="ApplicationShortcut" />
        </Feature>
    </Product>
</Wix>
