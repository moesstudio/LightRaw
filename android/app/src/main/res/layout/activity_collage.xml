<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lr_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/lr_surface"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <Button
            android:id="@+id/btnCollageBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="◀ Back"
            android:textColor="@color/lr_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Collage Builder"
            android:textColor="@color/lr_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCollageExport"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="@color/lr_accent"
            android:text="Save"
            android:textColor="@color/lr_on_accent" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivCollagePreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="14dp"
        android:layout_weight="1"
        android:contentDescription="Collage preview"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lr_surface"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRatio11"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="1:1"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btnRatio45"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="4:5"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btnRatio916"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="9:16"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btnBgToggle"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="Dark / Light"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Frame Border &amp; Spacing"
            android:textColor="@color/lr_text_muted"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sbCollageGap"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:max="48"
            android:progress="16" />
    </LinearLayout>

</LinearLayout>
