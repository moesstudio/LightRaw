<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lr_bg"
    android:fitsSystemWindows="true">

    <!-- Top Loupe Toolbar (Clean Vector Icons + Primary Export) -->
    <LinearLayout
        android:id="@+id/loupeTopBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/lr_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Grid"
            android:src="@drawable/ic_lr_back"
            app:tint="@color/lr_text" />

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Undo"
            android:src="@drawable/ic_lr_undo"
            app:tint="@color/lr_text" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Redo"
            android:src="@drawable/ic_lr_redo"
            app:tint="@color/lr_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnInfoToggle"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Photo Info HUD"
            android:src="@drawable/ic_lr_info"
            app:tint="@color/lr_text_muted" />

        <ImageButton
            android:id="@+id/btnHistToggle"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Histogram"
            android:src="@drawable/ic_lr_hist"
            app:tint="@color/lr_accent_light" />

        <ImageButton
            android:id="@+id/btnRateMode"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Rate &amp; Review"
            android:src="@drawable/ic_lr_rate"
            app:tint="@color/lr_text_muted" />

        <ImageButton
            android:id="@+id/btnMoreMenu"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Versions, History &amp; More"
            android:src="@drawable/ic_lr_more"
            app:tint="@color/lr_text" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/lr_accent"
            android:minWidth="68dp"
            android:paddingHorizontal="12dp"
            android:text="Export"
            android:textColor="@color/lr_on_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Touch Photo Canvas -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/rateBar"
        app:layout_constraintTop_toBottomOf="@id/loupeTopBar">

        <com.moestret.lightraw.ui.views.LoupeImageView
            android:id="@+id/loupeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.moestret.lightraw.ui.views.HistogramView
            android:id="@+id/histogramView"
            android:layout_width="148dp"
            android:layout_height="58dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp" />

        <!-- Floating Info HUD Card (loupeInfoView equivalent) -->
        <LinearLayout
            android:id="@+id/loupeInfoHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="166dp"
            android:background="#B8080808"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvInfoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo.jpg"
                android:textColor="@color/lr_text"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInfoDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1200 x 1500 · PV2012"
                android:textColor="@color/lr_text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBeforeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/before_badge"
            android:textColor="@color/lr_on_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEngineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="#A6080808"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="PV2012"
            android:textColor="@color/lr_text_muted"
            android:textSize="10sp" />

        <!-- Quick Prev/Next Filmstrip Stepper overlay pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="#A6080808"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnPrevPhoto"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="‹"
                android:textColor="@color/lr_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvFilmstripIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:text="1 / 1"
                android:textColor="@color/lr_text_secondary"
                android:textSize="10.5sp" />

            <Button
                android:id="@+id/btnNextPhoto"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="›"
                android:textColor="@color/lr_text"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Rate & Review Quick Culling Bar (Stars + Pick/Reject + Color Labels) -->
    <HorizontalScrollView
        android:id="@+id/rateBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/lr_surface_elevated"
        android:paddingHorizontal="10dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/quickStrip">

        <LinearLayout
            android:id="@+id/rateBarContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Contextual Quick Strip -->
    <HorizontalScrollView
        android:id="@+id/quickStrip"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/lr_surface"
        android:paddingHorizontal="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/panelScroll">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickAuto"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Auto"
                android:textColor="@color/lr_accent_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQuickMatchRef"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Match Ref"
                android:textColor="@color/lr_success"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQuickBeforeAfter"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Before / After"
                android:textColor="@color/lr_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQuickCopy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Copy"
                android:textColor="@color/lr_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQuickPaste"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Paste"
                android:textColor="@color/lr_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Expandable Parameter Sheet -->
    <ScrollView
        android:id="@+id/panelScroll"
        android:layout_width="match_parent"
        android:layout_height="236dp"
        android:background="@color/lr_surface"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/toolRailScroll">

        <LinearLayout
            android:id="@+id/panelContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Bottom Horizontal Tool Rail -->
    <HorizontalScrollView
        android:id="@+id/toolRailScroll"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/lr_bg"
        android:paddingHorizontal="6dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/toolRailContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
